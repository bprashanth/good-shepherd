FROM python:3.12-slim

ARG CODEX_VERSION=0.147.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
    && npm install -g "@openai/codex@${CODEX_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.high.txt ./
RUN pip install --no-cache-dir -r requirements.high.txt

COPY high_worker.py ./
COPY xlsx_diff.py ./high_pipeline/
COPY tools ./tools

COPY --from=pipeline benchmarks/wide/analytics_manifest.py ./high_pipeline/
COPY --from=pipeline benchmarks/wide/canonical.py ./high_pipeline/
COPY --from=pipeline benchmarks/wide/ecology_review.py ./high_pipeline/
COPY --from=pipeline benchmarks/wide/review_manifest.py ./high_pipeline/
COPY --from=pipeline benchmarks/wide/structured_pipeline.py ./high_pipeline/
COPY --from=pipeline benchmarks/wide/wide_bench.py ./high_pipeline/
COPY --from=pipeline benchmarks/wide/wide_diff.py ./high_pipeline/

ENV FORMIDABLE_HIGH_PIPELINE_DIR=/app/high_pipeline
ENV FORMIDABLE_RENDER_TOOL=/app/tools/render_page.py
CMD ["python3", "high_worker.py"]
