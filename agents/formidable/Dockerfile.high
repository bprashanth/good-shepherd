FROM python:3.12-slim

ARG LOW_CODEX_VERSION=0.144.4
ARG HIGH_CODEX_VERSION=0.147.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
    && npm install -g "@openai/codex@${LOW_CODEX_VERSION}" \
    && npm install --prefix /opt/formidable-high-codex "@openai/codex@${HIGH_CODEX_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.high.txt ./
RUN pip install --no-cache-dir -r requirements.high.txt

COPY high_worker.py ./
COPY worker.py ./
COPY prompts ./prompts
COPY xlsx_diff.py ./high_pipeline/
COPY tools ./tools

COPY high_pipeline ./high_pipeline

ENV FORMIDABLE_HIGH_PIPELINE_DIR=/app/high_pipeline
ENV FORMIDABLE_RENDER_TOOL=/app/tools/render_page.py
ENV FORMIDABLE_CODEX_BIN=/opt/formidable-high-codex/node_modules/.bin/codex
CMD ["python3", "high_worker.py"]
